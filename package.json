{
  "name": "@dsh-bio/dsh-bio-genie",
  "version": "0.3.0",
  "description": "生物信息学「许愿式分析」插件：双引擎执行器（bio_python：Biopython 全功能 + bio_r：R 4.6/Bioconductor 3.23 差异表达与组学分析）+ 高频语义化工具 + 出版级绘图 + 零依赖自举双环境（uv+venv+biopython / CRAN 安装器+BiocManager 自动下载到插件私有目录）。用户下载安装即可许愿式分析。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "src/**/*.js",
    "skills/**/*.md",
    "prompts/**/*.md",
    "python/bridge.py",
    "python/bio_ops.py",
    "python/requirements.txt",
    "python/figurelib/**/*",
    "r/**/*",
    "docs/**/*.md",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "bioinformatics",
    "biology",
    "bio-analysis",
    "biology-analysis",
    "biopython",
    "genomics",
    "sequence-analysis",
    "wish-coding",
    "python"
  ],
  "license": "MIT",
  "scripts": {
    "bench": "node scripts/test-throttle.mjs && node scripts/test-log.mjs && node scripts/test-memory.mjs && node scripts/test-skills.mjs && node scripts/test-ops.mjs && node scripts/test-r.mjs"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moonbowterfly/dsh-bio-genie.git"
  },
  "homepage": "https://github.com/moonbowterfly/dsh-bio-genie",
  "bugs": {
    "url": "https://github.com/moonbowterfly/dsh-bio-genie/issues"
  }
}