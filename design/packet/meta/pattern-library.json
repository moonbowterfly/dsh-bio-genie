{
  "$id": "bundle://meta/pattern-library.json",
  "title": "pattern library (data resource; never compiled by any validator)",
  "patterns": {
    "canonicalDecimal": {
      "pattern": "^(0|-?(0\\.[0-9]*[1-9]|[1-9][0-9]*(\\.[0-9]*[1-9])?))$",
      "match_mode": "full",
      "domain": "ascii",
      "max_len": 320
    },
    "sha256Hex": {
      "pattern": "^[0-9a-f]{64}$",
      "match_mode": "full",
      "domain": "ascii",
      "max_len": 64
    },
    "jsonPointer": {
      "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$",
      "match_mode": "full",
      "domain": "ascii",
      "max_len": 2048
    },
    "bundlePath": {
      "pattern": "^bundle://[A-Za-z0-9_./-]+$",
      "match_mode": "full",
      "domain": "ascii",
      "max_len": 512
    },
    "isoTimestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "match_mode": "full",
      "domain": "ascii",
      "max_len": 20
    }
  }
}
