# ============================================================
# dsh-bio-genie .gitignore（按仓库实际维护，2026-08-26 重写）
# 原则：npm 发布物以 package.json 的 files 为准；本文件只负责
#       把「不该进 git 的本地产物 / 内部文档」挡在门外。
# ============================================================

# ---- 插件运行时产物（惰性自举/执行时生成，永不入库）----
python-env/
python-env-*/
stdout
stdout/

# ---- 依赖与包管理 ----
node_modules/
.pnpm-store/
# 本地打包产物（npm/pnpm pack 试装用）
*.tgz

# ---- 本地测试/试跑产物（图/临时数据）----
figs/
out/
tmp/
# ---- Python 构建中间物 ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ---- 日志 / 备份 / 临时文件 ----
*.log
*.bak
*.tmp
tmp/

# ---- 本地草稿/调研产物（不入库；发布物以 package.json files 为准）----
docs/drafts/
docs/*.local.md
*.draft.md

# ---- 操作系统 / 编辑器 ----
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
